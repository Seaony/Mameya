---
import { Image, getImage } from 'astro:assets';
import Icon from '../../../../src/components/Icon.astro';
import logo from '../../../../src/assets/brand/logo.png';
import avatar from '../../../../src/assets/avatar.jpg';
import { apps, contact, telegram } from '../../../../src/data/apps';
import { ui } from '../../../../src/i18n/ui';
import icon from '../assets/icon.png';
import shotLightEn from '../assets/shot-light-en.jpg';
import shotDarkEn from '../assets/shot-dark-en.jpg';
import shotLightZh from '../assets/shot-light-zh.jpg';
import shotDarkZh from '../assets/shot-dark-zh.jpg';
import { links, platforms, formats, t, type Lang } from '../content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t[lang];

// 中文一行太长时，只在逗号、顿号、句号后面断开，不把词拆到两行（和主站简介一样）
const phrases = (line: string) => line.split(/(?<=[，、：；。])/);

// 文案里 `反引号` 包起来的是命令或路径，[文字](地址) 是链接；其余是普通文字
type Part = { kind: 'text' | 'code'; text: string } | { kind: 'link'; text: string; href: string };
const rich = (text: string): Part[] =>
  text
    .split(/(`[^`]+`|\[[^\]]+\]\([^)]+\))/)
    .filter(Boolean)
    .map((p) => {
      if (p.startsWith('`')) return { kind: 'code', text: p.slice(1, -1) };
      const link = p.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
      return link ? { kind: 'link', text: link[1], href: link[2] } : { kind: 'text', text: p };
    });

// README 里的产品宣传图，按语言和深浅色各一张；只出一张约 2 倍宽的大图，用 CSS 缩到正文宽度
const shots = lang === 'en' ? { light: shotLightEn, dark: shotDarkEn } : { light: shotLightZh, dark: shotDarkZh };
// 手机上下 720 宽的那张，桌面下 1280 宽的
const shotWidths = [720, 1280];
const shotSizes = '(max-width: 688px) calc(100vw - 40px), 640px';
const dark = await getImage({ src: shots.dark, widths: shotWidths, sizes: shotSizes, quality: 82 });
// 结尾的作者卡片直接用主站的个人信息，两边改一处就行
const me = ui[lang];
const others = apps.filter((a) => a.id !== 'momento');
const contacts = [
  { icon: 'mail', label: `${me.email}: ${contact.email}`, tip: contact.email, href: `mailto:${contact.email}` },
  { icon: 'github', label: `GitHub: @${contact.github.handle}`, tip: `github.com/${contact.github.handle}`, href: contact.github.url },
  { icon: 'x', label: `X: @${contact.x.handle}`, tip: `x.com/${contact.x.handle}`, href: contact.x.url },
  { icon: 'telegram', label: `Telegram: ${telegram.handle}`, tip: telegram.handle, href: telegram.url },
] as const;
---

<main>
  <section class="hero" aria-labelledby="name">
    <div class="product">
      <Image class="app-icon" src={icon} alt="" width={320} height={320} quality={90} loading="eager" />
      <div class="name-block">
        <h1 id="name">Momento</h1>
        <p class="tagline">{c.tagline}</p>
      </div>
    </div>

    <p class="intro">
      {
        c.intro.map((line) => (
          <span class="line">
            {phrases(line).map((p) => (
              <span class="phrase">{p}</span>
            ))}
          </span>
        ))
      }
    </p>

    {/* 三个平台各带图标，最后是免费开源 */}
    <ul class="req">
      {
        platforms.map(([icon, name]) => (
          <li>
            <Icon name={icon} size={15} />
            {name}
          </li>
        ))
      }
      <li>{c.free}</li>
    </ul>

    <div class="actions">
      <a class="btn" href={links.download}>
        <Icon name="download" size={17} />
        {c.download}
      </a>
      <ul class="links">
        <li class="ic">
          <a class="icb" href={links.github} aria-label={c.githubTip}>
            <Icon name="github" size={20} />
          </a>
          <span class="tip tip-text" aria-hidden="true">{c.githubTip}</span>
        </li>
        <li class="ic">
          <a class="icb" href={links.extension} aria-label={c.extension}>
            <Icon name="chromeLogo" size={20} />
          </a>
          <span class="tip tip-text" aria-hidden="true">{c.extension}</span>
        </li>
        <li class="ic">
          <a class="icb" href={links.changelog} aria-label={c.changelog}>
            <Icon name="history" size={20} />
          </a>
          <span class="tip tip-text" aria-hidden="true">{c.changelog}</span>
        </li>
      </ul>
    </div>
  </section>

  {/* 产品图跟着页面的深浅色：默认按系统，手动切过主题时由下面的脚本改 <source> 的 media */}
  <picture class="shot">
    <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} sizes={shotSizes} data-dark-source />
    <Image src={shots.light} alt={c.shotAlt} widths={shotWidths} sizes={shotSizes} quality={82} loading="eager" fetchpriority="high" />
  </picture>

  <section class="block" aria-labelledby="for-you">
    <h2 id="for-you">{c.forYou}</h2>
    <div class="prose">
      <p>{rich(c.problem).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</p>
      <p class="strong">{rich(c.answer).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</p>
      <p>{rich(c.fit).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</p>
    </div>
  </section>

  <section class="block" aria-labelledby="what-it-does">
    <h2 id="what-it-does">{c.whatItDoes}</h2>
    <dl class="facts">
      {
        c.features.map(([icon, label, text]) => (
          <div>
            <dt>
              <Icon name={icon} size={16} />
              {label}
            </dt>
            <dd>{rich(text).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* 浏览器扩展：四种保存方式和功能区同一种行，下面是限制、手动安装和去 GitHub 的按钮 */}
  <section class="block" aria-labelledby="extension">
    <h2 id="extension">{c.ext.title}</h2>
    <p class="lead">{c.ext.intro}</p>
    <dl class="facts">
      {
        c.ext.rows.map(([icon, label, text]) => (
          <div>
            <dt>
              <Icon name={icon} size={16} />
              {label}
            </dt>
            <dd>{text}</dd>
          </div>
        ))
      }
    </dl>
    <p class="note">{c.ext.limits}</p>
    {/* 手动安装：一张卡片，顶部标题和按钮；三步从上到下，每步左边说明、右边一个小示意图，画的是用户要找的那个东西 */}
    <div class="install">
      <div class="install-head">
        <span class="install-icon" aria-hidden="true"><Icon name="chrome" size={24} /></span>
        <div class="install-text">
          <p class="install-title">{c.ext.install.title}</p>
          <p class="install-sub">{c.ext.install.sub}</p>
        </div>
        <a class="btn btn-sm" href={links.extension}>
          <Icon name="github" size={16} />
          {c.ext.get}
        </a>
      </div>
      <ol class="install-steps">
        <li class="istep">
          {/* 1：压缩包解压出 extension 文件夹 */}
          <p class="istep-text"><span class="istep-num">1</span><span>{rich(c.ext.install.steps[0]).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</span></p>
          <div class="mock" aria-hidden="true">
            <span class="file"><Icon name="fileZip" size={16} />Manual-Install.zip</span>
            <Icon class="mock-arrow" name="arrowDown" size={14} />
            <span class="file file-on"><Icon name="folderSimple" size={16} />extension</span>
          </div>
        </li>
        <li class="istep">
          {/* 2：Chrome 扩展页右上角的开发者模式开关，画成打开的样子 */}
          <p class="istep-text"><span class="istep-num">2</span><span>{rich(c.ext.install.steps[1]).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</span></p>
          <div class="mock mock-chrome" aria-hidden="true">
            <span class="chrome-bar"><i></i><i></i><i></i></span>
            <span class="chrome-row">
              <span class="chrome-title">{c.ext.mock.extensions}</span>
              <span class="dev">{c.ext.mock.devMode}<span class="switch"></span></span>
            </span>
          </div>
        </li>
        <li class="istep">
          {/* 3：加载已解压的扩展程序按钮，选中 extension 文件夹 */}
          <p class="istep-text"><span class="istep-num">3</span><span>{rich(c.ext.install.steps[2]).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</span></p>
          <div class="mock" aria-hidden="true">
            <span class="load">{c.ext.mock.load}</span>
            <span class="file file-on"><Icon name="folderSimple" size={16} />extension<Icon class="file-check" name="check" size={14} /></span>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* 支持的格式：按 README 的表格分四组，有平台差异的组下面写一行说明 */}
  <section class="block" aria-labelledby="supported">
    <h2 id="supported">{c.supported}</h2>
    <div class="groups">
      {
        formats.map((g) => (
          <div class="group">
            <h3 class="group-label">{c.groups[g.id].label}</h3>
            <ul class="chips">
              {g.items.map((name) => (
                <li class="chip">
                  <Icon class={`fmt fmt-${g.id}`} name={g.icon} size={16} />
                  {name}
                </li>
              ))}
            </ul>
            {c.groups[g.id].note && <p class="note">{c.groups[g.id].note}</p>}
          </div>
        ))
      }
    </div>
  </section>

  <section class="block" aria-labelledby="privacy">
    <h2 id="privacy">{c.privacy}</h2>
    <dl class="facts">
      {
        c.privacyRows.map(([icon, label, text]) => (
          <div>
            <dt>
              <Icon name={icon} size={16} />
              {label}
            </dt>
            <dd>{rich(text).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="block" aria-labelledby="start">
    <h2 id="start">{c.start}</h2>
    <ol class="rows">
      {
        c.steps.map(([title, desc], i) => (
          <li class="row">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <span class="row-body">
              <span class="row-name">{title}</span>
              <span class="row-desc">{rich(desc).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p class="note warn">
      <Icon name="info" size={16} />
      <span>{rich(c.windowsNote).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a class="text-link" href={p.href}>{p.text}</a> : p.text))}</span>
    </p>
  </section>

  {/* 结尾是作者卡片：头像、名字、一句话介绍、联系方式，再链回主站 */}
  <section class="block" aria-labelledby="maker">
    <h2 id="maker">{c.maker}</h2>
    <div class="card">
      <div class="card-head">
        <Image class="avatar" src={avatar} alt={me.avatarAlt} width={160} height={160} quality={90} />
        <div class="who">
          <p class="who-name">Seaony</p>
          <p class="who-tagline">{me.tagline}</p>
        </div>
        <p class="where">
          <Icon name="mapPin" size={14} />
          {me.aboutRows.location[1]}
        </p>
      </div>
      <p class="bio">
        {
          me.intro.map((line) => (
            <span class="phrase">{line}</span>
          ))
        }
      </p>
      <div class="card-apps">
        <p class="card-label">{c.others}</p>
        <ul class="apps">
          {
            others.map((app) => {
              // 没有公开页面的产品只显示，不做成链接
              const Row = app.url ? 'a' : 'div';
              return (
                <li>
                  <Row class="app" href={app.url}>
                    <Image class="app-icon-sm" src={app.icon} alt="" width={160} height={160} quality={90} />
                    <span class="app-text">
                      <span class="app-name">
                        {app.name}
                        {app.inDevelopment && <span class="dev">{me.inDevelopment}</span>}
                      </span>
                      <span class="app-desc">{me.apps[app.id]}</span>
                    </span>
                  </Row>
                </li>
              );
            })
          }
        </ul>
      </div>
      <div class="card-foot">
        <ul class="links" aria-label={me.contactLabel}>
          {
            contacts.map((x) => (
              <li class="ic">
                <a class="icb" href={x.href} aria-label={x.label}>
                  <Icon name={x.icon} size={18} />
                </a>
                <span class="tip tip-text" aria-hidden="true">{x.tip}</span>
              </li>
            ))
          }
        </ul>
        <a class="home" href={links.home}>
          <Image class="home-logo" src={logo} alt="" width={96} height={96} quality={90} />
          mameya.app
          <Icon class="home-arrow" name="arrowUpRight" size={14} />
        </a>
      </div>
    </div>
  </section>
</main>

<script>
  // 手动切过主题时，产品图跟着页面换深浅色；没切过就交给 <source> 的系统深色媒体查询
  const root = document.documentElement;
  const source = document.querySelector<HTMLSourceElement>('[data-dark-source]');
  const apply = () => {
    if (!source) return;
    const theme = root.dataset.theme;
    source.media = theme === 'dark' ? 'all' : theme === 'light' ? 'not all' : '(prefers-color-scheme: dark)';
  };
  apply();
  new MutationObserver(apply).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
  main {
    padding-top: 48px;
  }

  /* 首屏和主站的个人信息一样：图标、名字、标语，下面按句分行的介绍 */
  .product {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .app-icon {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 18px;
    box-shadow:
      0 0 0 1px var(--line),
      0 8px 20px -12px var(--shadow);
  }

  .name-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  h1 {
    font-size: 26px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .tagline {
    font-size: 16px;
    color: var(--muted);
  }

  .intro {
    margin-top: 36px;
    font-size: 16px;
    line-height: 1.9;
  }

  :lang(en) .intro {
    line-height: 1.75;
  }

  .line {
    display: block;
    text-wrap: balance;
  }

  :lang(zh) .phrase {
    display: inline-block;
  }

  .req {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 14px;
    color: var(--faint);
  }

  .req li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .actions {
    margin-top: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .links {
    display: flex;
    gap: 2px;
  }

  .shot {
    display: block;
    margin-top: 48px;
  }

  .shot img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow:
      0 0 0 1px var(--line),
      0 20px 40px -28px var(--shadow);
  }

  /* 分组：标题加内容，和主站「关于」「产品」同一套间距 */
  .block {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* 分区标题比正文大一号、更粗，一眼和正文分开 */
  h2 {
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--muted);
  }

  :lang(zh) .prose {
    line-height: 1.85;
  }

  .prose .strong {
    color: var(--text);
  }

  dl,
  dd {
    margin: 0;
  }

  .facts > div {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px dashed var(--line2);
    font-size: 15px;
    line-height: 1.7;
  }

  .facts > div:last-child {
    border-bottom: 0;
  }

  /* 标签高度和右边第一行字一样，图标和文字都对齐第一行 */
  .facts dt {
    width: 112px;
    white-space: nowrap;
    height: 1.7em;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--faint);
  }

  .facts dt :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
  }

  .warn {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .warn :global(svg) {
    flex-shrink: 0;
    /* 图标对齐第一行字的中线 */
    margin-top: calc((1.7em - 16px) / 2);
  }

  .facts dd {
    text-wrap: pretty;
  }

  /* 命令和路径：等宽字、浅底，长路径在窄屏上可以断开 */
  code {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--surface2);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }

  .lead {
    font-size: 15px;
    line-height: 1.75;
    color: var(--muted);
  }

  :lang(zh) .lead {
    line-height: 1.85;
  }

  /* 手动安装卡片：和作者卡片同一种白底 */
  .install {
    margin-top: 8px;
    padding: 18px 20px 16px;
    border-radius: 20px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--line),
      0 16px 36px -28px var(--shadow);
  }

  .install-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .install-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--surface2);
  }

  .install-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .install-title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .install-sub {
    font-size: 13px;
    color: var(--muted);
  }

  .btn-sm {
    height: 36px;
    padding: 0 16px;
    font-size: 13.5px;
  }

  .install-steps {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  /* 每步一行：左边编号和说明，右边示意图；行间虚线 */
  .istep {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px dashed var(--line2);
  }

  .istep:last-child {
    border-bottom: 0;
    padding-bottom: 2px;
  }

  .istep .istep-text {
    flex: 1;
    min-width: 0;
  }

  /* 示意图：浅底小画框，里面画用户要在 Chrome 里找的东西 */
  .mock {
    width: 232px;
    flex-shrink: 0;
    height: 100px;
    border-radius: 12px;
    background: var(--surface2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px;
    overflow: hidden;
  }

  .file {
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 9px 0 7px;
    border-radius: 7px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11.5px;
    white-space: nowrap;
    color: var(--text);
  }

  .file :global(svg) {
    flex-shrink: 0;
    color: var(--faint);
  }

  .file-on {
    box-shadow: 0 0 0 1.5px var(--accent);
  }

  .file-on :global(svg) {
    color: var(--accent);
  }

  .mock :global(.mock-arrow) {
    color: var(--faint);
  }

  /* 第 2 步：一小块 Chrome 扩展页，标题栏三个圆点，右上角开发者模式开关 */
  .mock-chrome {
