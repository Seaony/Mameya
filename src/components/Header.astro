---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { langs, locales, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].header;
const current = locales[lang];
---

<header class="header" id="top">
  <a class="brand" href={current.path}>
    {/* 只出一张 4 倍大的图，用 CSS 缩到 24px 高；按 24px 出小图会糊 */}
    <Image class="logo" src={logo} alt="" width={99} height={96} quality={90} loading="eager" />
    Mameya
  </a>
  <nav class="controls" aria-label={t.site}>
    <div class="lang-wrap" data-lang-menu>
      <button
        class="lang"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="lang-menu"
      >
        <Icon name="globe" size={16} />
        <span class="visually-hidden">{t.language}: </span>
        <span>{current.short}</span>
      </button>
      <ul class="menu" id="lang-menu" aria-label={t.language} hidden>
        {
          langs.map((l) => (
            <li>
              <a
                class="opt"
                href={locales[l].path}
                lang={locales[l].htmlLang}
                hreflang={locales[l].hreflang}
                data-lang={l}
                aria-current={l === lang ? 'page' : undefined}
              >
                <span class="opt-label">
                  <span class="code mono">{locales[l].code}</span>
                  {locales[l].label}
                </span>
                <Icon class="check" name="check" size={15} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <ThemeToggle toDark={t.toDark} toLight={t.toLight} />
  </nav>
</header>

<script>
  // 语言菜单：点按钮开关，点外面或按 Esc 关闭
  const wrap = document.querySelector<HTMLElement>('[data-lang-menu]')!;
  const button = wrap.querySelector<HTMLButtonElement>('.lang')!;
  const menu = wrap.querySelector<HTMLElement>('.menu')!;

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
  };

  button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('click', (e) => {
    if (!wrap.contains(e.target as Node)) setOpen(false);
  });
  // 用 Tab 移出菜单时也收起
  wrap.addEventListener('focusout', (e) => {
    if (!wrap.contains(e.relatedTarget as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      button.focus();
    }
  });

  // 手动切过语言就记住，根路径不再按浏览器语言跳
  menu.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', a.dataset.lang!);
      } catch {}
    });
  });
</script>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 40px 0 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .logo {
    width: auto;
    height: 24px;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lang-wrap {
    position: relative;
  }

  .lang {
    height: 44px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 14px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .lang:hover {
    color: var(--text);
  }

  .menu {
    position: absolute;
    right: 0;
    top: 52px;
    z-index: 20;
    width: 184px;
    padding: 6px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 20px 44px -16px var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .menu[hidden] {
    display: none;
  }

  .opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 40px;
    padding: 0 10px 0 12px;
    border-radius: 10px;
    font-size: 14px;
    transition: background 0.15s;
  }

  .opt:hover,
  .opt[aria-current='page'] {
    background: var(--surface2);
  }

  /* 焦点框画在选项里面，不贴着菜单边缘 */
  .opt:focus-visible {
    outline-offset: -2px;
  }

  .opt-label {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .code {
    width: 22px;
    font-size: 11.5px;
    /* 当前项和悬停项是灰底，faint 在灰底上对比度不够 4.5:1，改用 muted */
    color: var(--muted);
  }

  /* 图标是 Icon 组件渲染的，不带本组件的作用域标记，所以用 :global 匹配 */
  .opt :global(.check) {
    color: var(--accent);
    opacity: 0;
  }

  .opt[aria-current='page'] :global(.check) {
    opacity: 1;
  }

</style>
