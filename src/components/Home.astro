---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { apps, contact, telegram, qrSocials } from '../data/apps';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const building = apps.find((a) => a.inDevelopment);

// 关于：所在、专注，加上技术栈三行，同一种行样式
const facts: [string, string][] = [
  t.aboutRows.location,
  t.aboutRows.focus,
  [t.stackRows.mac, 'Swift · SwiftUI'],
  [t.stackRows.web, 'TypeScript · React · Next.js · Node.js'],
  [t.stackRows.before, 'PHP · Laravel'],
];
---

<main>
  <section class="hero">
    <div class="person">
      <Image class="avatar" src={avatar} alt={t.avatarAlt} width={80} height={80} densities={[1, 2, 3]} loading="eager" />
      <div class="name-block">
        <h1>Seaony</h1>
        <p class="tagline">{t.tagline}</p>
      </div>
    </div>

    <p class="bio">{t.intro}</p>

    {
      building && (
        <p class="status">
          <span class="pulse" aria-hidden="true" />
          {t.building(building.name)}
        </p>
      )
    }

    <ul class="contacts" aria-label={t.contactLabel}>
      <li class="ic">
        <a class="icb" href={`mailto:${contact.email}`} aria-label={`${t.email}: ${contact.email}`}>
          <Icon name="mail" size={20} />
        </a>
        <span class="tip tip-text" aria-hidden="true">{contact.email}</span>
      </li>
      <li class="ic">
        <a class="icb" href={contact.github.url} aria-label={`GitHub: @${contact.github.handle}`}>
          <Icon name="github" size={20} />
        </a>
        <span class="tip tip-text" aria-hidden="true">github.com/{contact.github.handle}</span>
      </li>
      <li class="ic">
        <a class="icb" href={telegram.url} aria-label={`Telegram: ${telegram.handle}`}>
          <Icon name="telegram" size={20} />
        </a>
        <span class="tip tip-text" aria-hidden="true">Telegram · {telegram.handle}</span>
      </li>
      {
        qrSocials.map((s) => {
          const name = t.socials[s.id].name;
          return (
            <li class="ic" data-qr>
              <button class="icb" type="button" aria-label={`${name}: ${t.qrCode}`} aria-expanded="false" aria-controls={`qr-${s.id}`}>
                {/* 小红书是文字标志，放大一点才看得清 */}
                <Icon name={s.id} size={s.id === 'xiaohongshu' ? 26 : 20} />
              </button>
              <div class="tip tip-qr" id={`qr-${s.id}`}>
                <Image src={s.qr} alt={`${name} ${t.qrCode}`} width={136} height={136} densities={[2]} />
                <span>{t.socials[s.id].scan}</span>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="block" aria-labelledby="about-title">
    <h2 id="about-title">{t.about}</h2>
    <dl class="facts">
      {
        facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="block products" aria-labelledby="products-title">
    <h2 id="products-title">{t.projects}</h2>
    <ul class="rows">
      {
        apps.map((app) => (
          <li>
            <a class="row" href={app.url}>
              <Image class="row-icon" src={app.icon} alt="" width={40} height={40} densities={[2, 3]} />
              <span class="row-body">
                <span class="row-text">
                  <span class="row-head">
                    <span class="row-name">{app.name}</span>
                    {app.inDevelopment && <span class="dev">{t.inDevelopment}</span>}
                  </span>
                  <span class="row-desc">{t.apps[app.id]}</span>
                </span>
                <Icon class="row-arrow" name="arrowUpRight" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</main>

<script>
  // 手机上没有悬停：触屏点一下打开二维码，再点、点外面或按 Esc 关闭。
  // 鼠标靠悬停、键盘靠焦点显示，不走这里，免得桌面点一下卡片一直挂着。
  const items = document.querySelectorAll<HTMLElement>('[data-qr]');
  let lastPointer = '';
  document.addEventListener('pointerdown', (e) => (lastPointer = e.pointerType), { capture: true });

  const close = (item: HTMLElement) => {
    item.removeAttribute('data-open');
    item.querySelector('button')?.setAttribute('aria-expanded', 'false');
  };

  items.forEach((item) => {
    const button = item.querySelector('button')!;
    button.addEventListener('click', () => {
      const isTouch = lastPointer === 'touch' || lastPointer === 'pen';
      lastPointer = '';
      if (!isTouch) return;
      const open = !item.hasAttribute('data-open');
      items.forEach((other) => other !== item && close(other));
      item.toggleAttribute('data-open', open);
      button.setAttribute('aria-expanded', String(open));
    });
  });

  document.addEventListener('click', (e) => {
    items.forEach((item) => !item.contains(e.target as Node) && close(item));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    items.forEach(close);
    // 键盘聚焦或鼠标悬停时按 Esc，也要能收起提示
    (document.activeElement as HTMLElement | null)?.closest('.ic')?.setAttribute('data-dismissed', '');
    document.querySelectorAll('.ic:hover').forEach((ic) => ic.setAttribute('data-dismissed', ''));
  });

  document.querySelectorAll<HTMLElement>('.ic').forEach((ic) => {
    ic.addEventListener('focusout', () => ic.removeAttribute('data-dismissed'));
    ic.addEventListener('mouseleave', () => ic.removeAttribute('data-dismissed'));
  });
</script>

<style>
  main {
    padding-top: 48px;
  }

  .person {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .avatar {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 999px;
    object-fit: cover;
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 0 5px var(--line);
  }

  .name-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  h1 {
    font-size: 26px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .tagline {
    font-size: 16px;
    color: var(--muted);
  }

  .bio {
    margin-top: 36px;
    font-size: 16px;
    line-height: 1.9;
  }

  :lang(en) .bio {
    line-height: 1.75;
  }

  .status {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--accent-ink);
  }

  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 var(--accent-ring); }
    70% { box-shadow: 0 0 0 6px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .contacts {
    margin: 20px 0 0 -10px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px;
  }

  .icb {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .icb:hover,
  .ic[data-open] .icb {
    background: var(--surface2);
    color: var(--text);
  }

  .tip-text {
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--btn);
    color: var(--btn-ink);
    font-size: 13px;
    white-space: nowrap;
    box-shadow: 0 10px 24px -10px var(--shadow);
  }

  .tip-qr {
    /* 卡片显示时能接收长按和右键，方便直接保存二维码；鼠标移到卡片上也不会消失 */
    pointer-events: auto;
    padding: 12px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 20px 44px -16px var(--shadow);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .tip-qr img {
    width: 136px;
    height: 136px;
    border-radius: 10px;
    background: #fff;
  }

  .tip-qr span {
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .ic[data-dismissed] .tip {
    opacity: 0;
    visibility: hidden;
  }

  .block {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .products {
    margin-top: 56px;
  }

  h2 {
    font-size: 15px;
    font-weight: 500;
  }

  dl,
  dd {
    margin: 0;
  }

  .facts > div {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px dashed var(--line2);
    font-size: 15px;
  }

  .facts > div:last-child {
    border-bottom: 0;
  }

  .facts dt {
    width: 72px;
    flex-shrink: 0;
    color: var(--faint);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .row-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 10px;
    box-shadow:
      0 0 0 1px var(--line),
      0 1px 2px var(--shadow);
    transition: transform 0.3s var(--ease);
  }

  .row-body {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--line2);
  }

  .rows li:last-child .row-body {
    border-bottom: 0;
  }

  .row-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .row-name {
    font-size: 15.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }

  .dev {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }

  .row-desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .row :global(.row-arrow) {
    flex-shrink: 0;
    color: var(--faint);
    transition:
      transform 0.25s var(--ease),
      color 0.2s;
  }

  .row:hover .row-icon {
    transform: translateY(-1px) scale(1.05);
  }

  .row:hover .row-name {
    color: var(--accent-ink);
  }

  .row:hover :global(.row-arrow) {
    transform: translate(2px, -2px);
    color: var(--text);
  }

  .row:focus-visible {
    border-radius: 12px;
  }

  /* 窗口窄、左边没留白时，第一个提示靠左对齐，不伸出屏幕（translate 抵消掉居中用的 -50%） */
  @media (max-width: 840px) {
    .ic:first-child .tip {
      left: 0;
      translate: 50% 0;
    }
  }

  @media (max-width: 560px) {
    main {
      padding-top: 32px;
    }

    /* 窄屏上最后一个二维码靠右对齐，不伸出屏幕右边 */
    .ic:last-child .tip {
      left: auto;
      right: 0;
      translate: 50% 0;
    }
  }
</style>
