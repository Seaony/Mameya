---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import bean from '../assets/brand/bean-404.png';
import { locales, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].notFound;
---

<main class="nf">
  {/* 「404」中间的 0 换成迷路的小毛豆 */}
  <p class="code" aria-hidden="true">
    <span>4</span>
    <Image class="bean" src={bean} alt="" width={106} height={160} densities={[2, 3]} loading="eager" />
    <span>4</span>
  </p>

  <h1>{t.heading}</h1>
  <p class="body">{t.body}</p>

  <a class="home" href={locales[lang].path}>
    <Icon name="arrowLeft" size={16} />
    {t.home}
  </a>
</main>

<style>
  .nf {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 0 64px;
    background-image: radial-gradient(520px 320px at 50% 38%, var(--glow), transparent 70%);
  }

  .code {
    display: flex;
    align-items: center;
    font-size: 168px;
    line-height: 0.9;
    font-weight: 600;
    letter-spacing: -0.07em;
  }

  /* 小毛豆和数字 4 一样高，左右留出和字距相当的空隙 */
  .bean {
    width: auto;
    height: 0.95em;
    margin: 0 0.06em 0 0.07em;
  }

  h1 {
    margin-top: 32px;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .body {
    margin-top: 12px;
    max-width: 420px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--muted);
  }

  .home {
    margin-top: 32px;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--btn);
    color: var(--btn-ink);
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .home:hover {
    opacity: 0.86;
  }

  @media (max-width: 560px) {
    .code {
      font-size: clamp(96px, 30vw, 168px);
    }
  }
</style>
