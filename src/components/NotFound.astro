---
import { Image } from 'astro:assets';
import bean from '../assets/brand/bean-404.png';
import { apps, contact } from '../data/apps';
import { locales, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].notFound;
const mekke = apps.find((a) => a.id === 'mekke')!;
const shipped = apps.filter((a) => !a.inDevelopment);
---

<main class="nf">
  <div class="badge">
    <Image class="bob" src={mekke.icon} alt="" width={26} height={26} densities={[2, 3]} loading="eager" />
    {t.badge}
  </div>

  {/* 「404」中间的 0 换成迷路的小毛豆 */}
  <p class="code" aria-hidden="true">
    <span>4</span>
    <Image class="bean" src={bean} alt="" width={106} height={160} densities={[2, 3]} loading="eager" />
    <span>4</span>
  </p>

  <h1>{t.heading}</h1>
  <p class="body">{t.body}</p>

  <div class="actions">
    <a class="btn btn-primary" href={locales[lang].path}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
      {t.home}
    </a>
    <a class="btn btn-ghost" href={`mailto:${contact.email}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
      {t.report}
    </a>
  </div>

  <div class="suggest">
    <span class="suggest-title">{t.suggest}</span>
    <ul class="chips">
      {
        shipped.map((app) => (
          <li>
            <a class="chip" href={app.url}>
              <Image src={app.icon} alt="" width={28} height={28} densities={[2, 3]} />
              {app.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</main>

<style>
  .nf {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 0 64px;
    background-image: radial-gradient(520px 320px at 50% 38%, var(--glow), transparent 70%);
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 10px;
    /* 设计稿里边框算在 36px 外面，实际高 38px */
    box-sizing: content-box;
    height: 36px;
    padding: 0 14px 0 6px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 13.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .bob {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    animation: bob 3.2s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-6px) rotate(3deg); }
  }

  .code {
    margin-top: 28px;
    display: flex;
    align-items: center;
    font-size: 168px;
    line-height: 0.9;
    font-weight: 600;
    letter-spacing: -0.07em;
  }

  /* 小毛豆和数字 4 一样高，左右留出和字距相当的空隙 */
  .bean {
    width: auto;
    height: 0.95em;
    margin: 0 0.06em 0 0.07em;
  }

  h1 {
    margin-top: 32px;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .body {
    margin-top: 12px;
    max-width: 420px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }

  .btn {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    border-radius: 999px;
    font-size: 14.5px;
    white-space: nowrap;
  }

  .btn-primary {
    padding: 0 20px;
    background: var(--btn);
    color: var(--btn-ink);
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .btn-primary:hover {
    opacity: 0.86;
  }

  .btn-ghost {
    padding: 0 18px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: background 0.2s, border-color 0.2s;
  }

  .btn-ghost:hover {
    background: var(--surface2);
    border-color: var(--line2);
  }

  .suggest {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .suggest-title {
    font-size: 13px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 640px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px 0 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 14px;
    transition: border-color 0.2s, transform 0.2s;
  }

  .chip:hover {
    border-color: var(--line2);
    transform: translateY(-1px);
  }

  .chip img {
    width: 28px;
    height: 28px;
    border-radius: 8px;
  }

  @media (max-width: 560px) {
    .code {
      font-size: clamp(96px, 30vw, 168px);
    }

    .badge {
      white-space: normal;
      height: auto;
      min-height: 36px;
      padding-block: 4px;
    }
  }
</style>
