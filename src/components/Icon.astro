---
// 内联 SVG 图标，颜色跟随文字（currentColor）
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size: number;
  class?: string;
}

const { name, size, class: className } = Astro.props;
const icon = icons[name];
---

<svg class={className} width={size} height={size} viewBox={icon.viewBox} aria-hidden="true" set:html={icon.body} />
